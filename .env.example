# ─────────────────────────────────────────────────────────────────
# Thinkr Environment Variables
# Copy this to .env (never commit .env to git)
# All values below are used ONLY in the Netlify serverless function.
# They are NEVER bundled into the client-side React code.
# ─────────────────────────────────────────────────────────────────

# ── Primary LLM: Groq ─────────────────────────────────────────────
# Free account at https://console.groq.com
# Generous rate limits, very fast inference.
LLM_PRIMARY_BASE_URL=https://api.groq.com/openai/v1
LLM_PRIMARY_API_KEY=gsk_your_groq_api_key_here
LLM_PRIMARY_MODEL=llama-3.3-70b-versatile

# ── Fallback LLM: OpenRouter ──────────────────────────────────────
# Free account at https://openrouter.ai
# Used automatically when Groq is rate-limited or unavailable.
# Pick any ":free" model from https://openrouter.ai/models?q=free
LLM_FALLBACK_BASE_URL=https://openrouter.ai/api/v1
LLM_FALLBACK_API_KEY=sk-or-v1-your_openrouter_key_here
LLM_FALLBACK_MODEL=meta-llama/llama-3.1-8b-instruct:free
